# Backend environment (copy to server/.env or set in Render dashboard).
# Never commit real keys.

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS. Backend only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where pipeline uploads/outputs are written (ephemeral on Render Free).
DATA_DIR=data/jobs

# Signed playback/download URL lifetime, seconds.
SIGNED_URL_TTL=3600
